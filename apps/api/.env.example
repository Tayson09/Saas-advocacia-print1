# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR EXPRESS
# ==============================================================================
PORT=3000
NODE_ENV=development

# ==============================================================================
# CONEXÃO COM O BANCO DE DADOS (POSTGRESQL)
# ==============================================================================
# Substitua os valores abaixo pelos dados do seu container Docker/Postgres.
# IMPORTANTE: Se a sua senha tiver caracteres especiais (como *), lembre-se de 
# codificá-la em formato URL (ex: * vira %2A).
DATABASE_URL="postgresql://USUARIO_DO_BANCO:SENHA_DO_BANCO@localhost:5432/NOME_DO_BANCO?schema=public"

# ==============================================================================
# SEGURANÇA E AUTENTICAÇÃO JWT (PADRÃO OWASP)
# ==============================================================================
# Dica: Você pode gerar chaves fortes de 256 bits rodando o comando no terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET="insira_aqui_uma_chave_secreta_de_pelo_menos_32_caracteres"
REFRESH_SECRET="insira_aqui_outra_chave_secreta_de_pelo_menos_32_caracteres"

# Validações estritas de Emissor e Audiência
JWT_ISSUER="sistema-advocacia-api"
JWT_AUDIENCE="electron-client-app"


# ==============================================================================
# SERVIÇO DE E-MAIL (RESEND)
# ==============================================================================
# Convite de configuração de senha enviado ao cadastrar um usuário.
# A chave deve começar com "re_" (crie em https://resend.com/api-keys).
API_KEY_RESEND="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Remetente verificado no Resend. Para testes, use o domínio de sandbox:
EMAIL_FROM="Verum <onboarding@resend.dev>"
# URL do front-end, usada para montar o link de configuração de senha:
FRONTEND_URL="http://localhost:5173"